# Postgres connection string. Local dev uses the Homebrew Postgres instance;
# production points at the hosted database.
DATABASE_URL=postgresql://user@localhost:5432/gigzman_client_sites

# Signing secret for dashboard session cookies. Generate with:
#   openssl rand -base64 32
AUTH_SECRET=

# "path" -> tenant resolved from /{vertical}/{client}/... (shared deployment)
# "host"  -> tenant resolved from the request hostname (custom domain)
TENANT_MODE=path

# Gates the public template-library pages (/ and /{vertical}) and the
# internal /admin deployment index. Client tenant sites are never gated.
# Generate the hash with: node -e "console.log(require('bcryptjs').hashSync('<password>', 10))"
PLATFORM_ADMIN_EMAIL=
PLATFORM_ADMIN_PASSWORD_HASH=

# Durable file storage for uploaded logos and property images.
# UNSET  -> files are written under public/uploads/ (fine locally; on Vercel the
#           filesystem is ephemeral, so an upload 404s after the next deploy).
# SET    -> uploads go to Vercel Blob instead. Required in production.
BLOB_READ_WRITE_TOKEN=

# Google Places API key for the Business Profile autofill on the client form.
# Server-side only — never exposed to the browser. Unset, the Fetch button is
# disabled and every field is entered by hand.
GOOGLE_PLACES_API_KEY=
